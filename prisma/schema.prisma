// Coral Litúrgico — modelo de dados
// Banco relacional (PostgreSQL) acessado via Prisma ORM.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papel de uma pessoa dentro de uma capela: o Coordenador organiza calendário
/// e equipe daquela capela, o Músico consulta escalas e cifras. O mesmo usuário
/// pode ter papéis diferentes em capelas diferentes (veja CapelaMembership).
enum Role {
  COORDENADOR
  MUSICO
}

/// Qual liturgia uma missa de sábado segue. Vazio decide pelo horário.
enum LiturgyChoice {
  SABADO
  DOMINGO
}

/// Natureza da evento no painel de agenda.
enum CelebrationType {
  MISSA_COMUM
  MISSA_SOLENE
  ENSAIO
}

/// Tempos litúrgicos do Rito Romano.
enum LiturgicalSeason {
  ADVENTO
  NATAL
  QUARESMA
  TRIDUO_PASCAL
  PASCOA
  TEMPO_COMUM
}

/// Momentos do rito aos quais uma música pode ser associada.
enum LiturgicalMoment {
  ENTRADA
  HINOS
  ATO_PENITENCIAL
  GLORIA
  SALMO
  ACLAMACAO
  LADAINHA
  OFERTORIO
  SANTO
  ORACAO_EUCARISTICA
  CORDEIRO
  COMUNHAO
  ACAO_DE_GRACAS
  FINAL
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  /// Vozes e instrumentos da pessoa (ex.: "Soprano", "Violão").
  instruments       String[]
  /// Dono do sistema: coordena todas as capelas, cria capelas e adiciona
  /// pessoas em qualquer uma. Vale true ou NULL, nunca false: como o índice
  /// único ignora NULL, o próprio banco garante um único dono.
  isOwner           Boolean? @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  celebrations       Celebration[] @relation("CelebrationCreatedBy")
  songs              Song[]        @relation("SongCreatedBy")
  capelasCreated     Capela[]      @relation("CapelaCreatedBy")
  invitesCreated     Invite[]      @relation("InviteCreatedBy")
  invitesRedeemed    Invite[]      @relation("InviteUsedBy")
  /// Celebrações em que canta ou toca, mesmo as de outra capela (participação mista).
  participatingIn    Celebration[] @relation("CelebrationParticipants")
  passwordResets     PasswordResetToken[]
  memberships        CapelaMembership[]
}

/// Liturgia de um dia, copiada da API pública para o site não depender dela.
/// `payload` nulo marca um dia que a API não tinha: é consultado de novo depois.
model LiturgyDay {
  date      DateTime @id @db.Date
  payload   Json?
  fetchedAt DateTime @default(now())
}

/// Vínculo entre uma pessoa e uma capela, com o papel dela ali.
model CapelaMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capelaId  String
  capela    Capela   @relation(fields: [capelaId], references: [id], onDelete: Cascade)
  role      Role     @default(MUSICO)
  createdAt DateTime @default(now())

  @@unique([userId, capelaId])
  @@index([capelaId])
}

/// Uma capela/paróquia: agrupa membros e celebrações.
model Capela {
  id          String   @id @default(cuid())
  name        String
  createdById String?
  createdBy   User?    @relation("CapelaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  CapelaMembership[]
  celebrations Celebration[] @relation("CelebrationCapela")
  invites      Invite[]

  @@index([createdById])
}

/// Convite de cadastro: um link/token que um coordenador gera para uma
/// capela específica. Quem usa entra direto naquela capela, como Músico.
model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  capelaId    String
  capela      Capela    @relation(fields: [capelaId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([capelaId])
}

/// Pedido de "esqueci minha senha". Guardamos apenas o SHA-256 do token: o
/// valor em claro só existe no link enviado por e-mail, então quem ler o
/// banco não consegue redefinir a senha de ninguém. Cada token vale uma vez
/// e expira em pouco tempo.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Celebration {
  id          String           @id @default(cuid())
  title       String
  /// Data e horário da evento.
  date        DateTime
  type        CelebrationType  @default(MISSA_COMUM)
  season      LiturgicalSeason
  location    String?
  notes       String?
  capelaId    String
  capela      Capela           @relation("CelebrationCapela", fields: [capelaId], references: [id], onDelete: Cascade)
  /// Só faz sentido em missa de sábado; vazio segue a regra das 17h.
  liturgyChoice LiturgyChoice?
  createdById String?
  createdBy   User?            @relation("CelebrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  repertoire RepertoireItem[]
  /// Integrantes escalados, de qualquer capela (a própria some primeiro na tela).
  participants User[] @relation("CelebrationParticipants")

  @@index([date])
  @@index([type])
  @@index([capelaId])
}

model Song {
  id          String             @id @default(cuid())
  title       String
  composer    String?
  /// Letra com cifras em formato ChordPro: "[G]Pai Nosso que est[C]ais no c[G]éu".
  chordPro    String
  /// Tom original em que a cifra foi escrita (ex.: "G", "Bb", "F#m").
  originalKey String
  /// Link externo para ouvir a música (YouTube, Spotify etc.).
  audioUrl    String?
  /// Momentos do rito para os quais a música é adequada.
  moments     LiturgicalMoment[]
  /// Tempos litúrgicos adequados; vazio significa "qualquer tempo".
  seasons     LiturgicalSeason[]
  /// Tags livres para achar a música (ex.: novenasaofrancisco), sem o #.
  tags        String[]         @default([])
  /// Texto da letra sem acordes, mantido para busca por trecho.
  plainLyrics String
  createdById String?
  createdBy   User?              @relation("SongCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  repertoire RepertoireItem[]

  @@index([title])
}

/// Roteiro musical: liga uma música do acervo a um momento do rito
/// de uma evento específica.
model RepertoireItem {
  id            String           @id @default(cuid())
  celebrationId String
  celebration   Celebration      @relation(fields: [celebrationId], references: [id], onDelete: Cascade)
  songId        String
  song          Song             @relation(fields: [songId], references: [id], onDelete: Restrict)
  moment        LiturgicalMoment
  /// Ordem dentro do mesmo momento (permite duas músicas na comunhão).
  position      Int              @default(0)
  /// Tom escolhido para esta evento; nulo usa o tom original.
  keyOverride   String?
  createdAt     DateTime         @default(now())

  @@unique([celebrationId, moment, position])
  @@index([songId])
}
