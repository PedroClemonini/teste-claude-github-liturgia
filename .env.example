# Banco relacional (PostgreSQL) usado pela aplicação
DATABASE_URL="postgresql://usuario:senha@localhost:5432/coral?schema=public"

# Banco separado para a suíte de testes — ela limpa as tabelas entre os casos,
# por isso nunca deve apontar para o banco de trabalho.
DATABASE_URL_TEST="postgresql://usuario:senha@localhost:5432/coral_test?schema=public"

# Segredo do NextAuth (Auth.js) — gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor"
NEXTAUTH_URL="http://localhost:3000"
