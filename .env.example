# Banco relacional (PostgreSQL) usado pela aplicação
DATABASE_URL="postgresql://usuario:senha@localhost:5432/coral?schema=public"

# Banco separado para a suíte de testes — ela limpa as tabelas entre os casos,
# por isso nunca deve apontar para o banco de trabalho.
DATABASE_URL_TEST="postgresql://usuario:senha@localhost:5432/coral_test?schema=public"

# Segredo do NextAuth (Auth.js) — gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor"
NEXTAUTH_URL="http://localhost:3000"

# ---- Envio de e-mail (recuperação de senha) ----------------------------
# Sem estas variáveis o app continua funcionando: o link de redefinição vai
# para o log do servidor em vez do e-mail da pessoa.
# SMTP_SECURE é opcional — por padrão, true na porta 465 e false na 587.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=suporte@paroquiasfranciscoxavier.com.br
SMTP_PASSWORD=
# SMTP_SECURE=false
MAIL_FROM="Coral Litúrgico <suporte@paroquiasfranciscoxavier.com.br>"

# Base dos links enviados por e-mail. Vem daqui, e não do cabeçalho Host da
# requisição, para que ninguém possa forjar um link de redefinição.
# Se ausente, cai no NEXTAUTH_URL.
APP_URL=https://paroquiasfranciscoxavier.com.br
